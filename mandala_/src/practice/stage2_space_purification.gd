extends RefCounted
## Этап 2. Очищение пространства: Гаятри, Махамритьюнджая, Асатома, Гурур Брахма.
## Сцена остаётся как после этапа 1: древо Прибежища и сияние; во время пения мантры святые мягко сияют.

const TITLE := "2. Очищение пространства"
const AUDIO := "res://audio/teurgia1/space_purification.ogg"
const DURATION := 229.0

# Где в записи поются мантры (начало, конец) — по огибающей громкости; перед каждой — пояснение ведущего
const SUNG := [Vector2(40.0, 57.7), Vector2(103.5, 121.8), Vector2(156.0, 172.2), Vector2(202.5, 223.3)]

# Точки перехода стрелками ← →: начало пояснения и начало пения каждой мантры
const CUES := [0.0, 40.0, 60.0, 103.5, 125.5, 156.0, 174.0, 202.5]

# По записи: «настройтесь на бога Солнца Сурью» (19 с) … конец Гаятри; «обращаемся к Шиве» (59 с) … конец мантры
const SURYA := Vector2(19.0, 62.0)
const SHIVA := Vector2(62.0, 124.5)

const GAYATRI := "Ом бхур бхувах сваха,\nтат савитур вареньйам,\nбхарго дэвасьйа дхимахи,\nдхьйо йо нах прачодайат"
const MAHAMRITYUNJAYA := "Ом трйамбакам йаджамахе,\nсугандхим пушти вардханам,\nурварукамива бандханам,\nмритьор мукшийа ма'мритатэ"
const ASATOMA := "Ом асато ма сат гамайя,\nтамасо ма джьотир гамайя,\nмритьюр ма амритам гамайя"
const GURUR_BRAHMA := "Гурур Брахма, гурур Вишну,\nгурур дэво Махешвара,\nгуру сакшат Парабрахма,\nтасмай шри гураве намаха"

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[0.5, 18.5, "", "Теперь мы действуем из чистого света — как иллюзорное тело.\nТело снова выходит из света, но оно уже немного очищено."],
	[19.0, 39.5, "Мантра Гаятри", "Обращаемся к богу Солнца с просьбой пробудить наш духовный разум.\nПодумайте о Солнце, настройтесь на божество Солнца — Сурью."],
	[40.0, 58.5, "Гаятри", GAYATRI],
	[60.0, 103.0, "Махамритьюнджая-мантра", "Обращаемся к Шиве за защитой этого пространства. Трёхликий, четырёхрукий: из кувшинов он льёт воду себе на голову, на шее змея, в волосах луна.\nМы просим его защитить пространство от всех вредоносных влияний — как спелый огурец легко отделяется от стебля, так легко пусть уходят все препятствия."],
	[103.5, 122.5, "Махамритьюнджая", MAHAMRITYUNJAYA],
	[125.5, 155.5, "Гимн Асатома", "Обращаемся к Ишваре, Владыке Вселенной, — к Даттатрейе в форме Ишвары:\nведи нас от неистинного к Истине, от тьмы к свету, от смерти к бессмертию."],
	[156.0, 173.0, "Асатома", ASATOMA],
	[174.0, 202.0, "Мантра «Гурур Брахма»", "Последняя молитва — к древу Прибежища, к линии Гуру, к принципу Гуру. Призываем благословение коренного Гуру, Парам Гуру Брахмананды, Иштадеваты Гуру Даттатрейи, Гуру-ачарьи Шри Шанкары и всех святых древа Прибежища."],
	[202.5, 224.0, "Гурур Брахма", GURUR_BRAHMA],
	[224.5, 229.0, "", "Поклон."],
]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Всё остаётся как после этапа 1
	fx.tree_reveal = 1.0
	fx.om_intensity = 0.0
	fx.om_halo = 0.0
	fx.rays_out = 0.0
	fx.rays_in = 0.0
	fx.veil_fill = 0.0
	fx.veil_alpha = 0.0
	# «Тело снова выходит из чистого света» — этап начинается в свете, и он плавно рассеивается
	fx.whiteout = 1.0 - smoothstep(2.0, 14.0, t)

	# Гаятри: над древом восходит солнце — Сурья
	fx.sun = _win(t, SURYA.x, SURYA.y, 5.0, 5.0)
	# Махамритьюнджая: слева от древа во вспышке света появляется Шива и уходит так же, после мантры
	fx.shiva = 1.0 if t >= SHIVA.x and t < SHIVA.y else 0.0
	fx.shiva_flash = exp(-pow((t - SHIVA.x) / 1.4, 2.0)) + exp(-pow((t - SHIVA.y) / 1.4, 2.0))

	# Во время пения святые и сияние мягко разгораются
	var sing := 0.0
	for s in SUNG:
		sing = maxf(sing, _win(t, s.x, s.y + 1.5, 3.0, 4.0))
	fx.tree_shine = 0.6 * sing
	fx.aura = 0.6 + 0.35 * sing

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
