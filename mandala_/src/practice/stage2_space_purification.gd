extends RefCounted
## Этап 2. Очищение пространства: Гаятри, Махамритьюнджая, Асатома, Гурур Брахма.
## Сцена остаётся как после этапа 1: древо Прибежища и сияние; во время пения мантры святые мягко сияют.

const TITLE := "2. Очищение пространства"
const AUDIO := "res://audio/teurgia1/space_purification.ogg"
const DURATION := 229.0

# Где в записи поются мантры (начало, конец) — по огибающей громкости; перед каждой — пояснение ведущего
const SUNG := [Vector2(40.0, 57.7), Vector2(103.5, 121.8), Vector2(156.0, 172.2), Vector2(202.5, 223.3)]

# Точки перехода стрелками ← →: начало пояснения и начало пения каждой мантры
const CUES := [0.0, 40.0, 60.0, 103.5, 125.5, 156.0, 174.0, 202.5]

const GAYATRI := "ОМ  БХУР  БХУВАХ  СВАХА\nТАТ  САВИТУР  ВАРЕНЬЙАМ\nБХАРГО  ДЭВАСЬЙА  ДХИМАХИ\nДХЬЙО  ЙО  НАХ  ПРАЧОДАЙАТ"
const MAHAMRITYUNJAYA := "ОМ  ТРЙАМБАКАМ  ЙАДЖАМАХЕ\nСУГАНДХИМ  ПУШТИ  ВАРДХАНАМ\nУРВАРУКАМИВА  БАНДХАНАМ\nМРИТЬОР  МУКШИЙА  МА'МРИТАТЭ"
const ASATOMA := "ОМ  АСАТО  МА  САТ  ГАМАЙЯ\nТАМАСО  МА  ДЖЬОТИР  ГАМАЙЯ\nМРИТЬЮР  МА  АМРИТАМ  ГАМАЙЯ"
const GURUR_BRAHMA := "ГУРУР  БРАХМА  ГУРУР  ВИШНУ\nГУРУР  ДЭВО  МАХЕШВАРА\nГУРУ  САКШАТ  ПАРАБРАХМА\nТАСМАЙ  ШРИ  ГУРАВЕ  НАМАХА"

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[0.5, 39.5, "Мантра Гаятри", "Пробуждает внутреннюю интуицию, внутреннее солнечное божество — энергию внутренней ясности."],
	[40.0, 58.5, "Гаятри", GAYATRI],
	[60.0, 103.0, "Махамритьюнджая-мантра", "Защитный круг Шивы: слоги мантры движутся по часовой стрелке и не дают вредоносным силам приблизиться."],
	[103.5, 122.5, "Махамритьюнджая", MAHAMRITYUNJAYA],
	[125.5, 155.5, "Гимн Асатома", "Призывает благословляющую силу Абсолюта, устанавливает канал связи с божественным."],
	[156.0, 173.0, "Асатома", ASATOMA],
	[174.0, 202.0, "Мантра «Гурур Брахма»", "Призывание благословений Бхагавана Даттатрейи, Древа Прибежища и коренного Гуру — их светящиеся формы над головой."],
	[202.5, 224.0, "Гурур Брахма", GURUR_BRAHMA],
]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Всё остаётся как после этапа 1
	fx.tree_reveal = 1.0
	fx.om_intensity = 0.0
	fx.om_halo = 0.0
	fx.rays_out = 0.0
	fx.rays_in = 0.0
	fx.veil_fill = 0.0
	fx.veil_alpha = 0.0
	fx.whiteout = 0.0

	# Во время пения святые и сияние мягко разгораются
	var sing := 0.0
	for s in SUNG:
		sing = maxf(sing, _win(t, s.x, s.y + 1.5, 3.0, 4.0))
	fx.tree_shine = 0.6 * sing
	fx.aura = 0.6 + 0.35 * sing

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
