extends RefCounted
## Этап 1. Гуру-йога с Ом: призывание, впитывание и растворение (трижды Ом).
## Все эффекты — функции времени записи t, поэтому перемотка вперёд/назад работает без накопления состояния.

const TITLE := "1. Гуру-йога с Ом"
const AUDIO := "res://audio/teurgia1/guru_yoga_om.ogg"
const DURATION := 132.0

# Где в записи звучат три Ом (начало, конец) и звук поклона — по огибающей громкости
const OM1 := Vector2(40.5, 51.0)
const OM2 := Vector2(73.5, 84.0)
const OM3 := Vector2(107.7, 118.5)
const BOW := 124.5

# Точки перехода стрелками ← →
const CUES := [0.0, 40.0, 52.0, 73.0, 85.0, 107.0, 124.0]

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[0.0, 14.0, "Гуру-йога с Ом", "Сложите руки в намастэ на уровне груди.\nСмотрите в пространство, отпустите ум."],
	[14.5, 28.0, "", "Перед вами проявляется древо Прибежища — Даттатрейя, святые и божества линии передачи."],
	[28.5, 39.0, "", "Представьте в груди символ Ом в пятицветном радужном сиянии."],
	[40.5, 52.0, "Ом", "Лучи от символа Ом расходятся во все стороны, входят в измерение святых, призывая их мудрость и благословения."],
	[53.0, 72.5, "", "Благословляющая сила святых входит в тонкое тело лучами света…"],
	[73.5, 85.0, "Ом", "…и насыщает его белым чистым светом с макушки до ног, растворяя кармическое видение."],
	[86.0, 106.5, "", "Тело полностью растворяется в чистом пространстве света."],
	[107.7, 121.0, "Ом", "Пространство сознания и ум святых, Гуру и Даттатрейи стали одним целым."],
	[124.5, 132.0, "", "Поклон."],
]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Древо Прибежища: в начале пусто, затем проявляется целиком вместе с сиянием и дальше остаётся
	var tree := smoothstep(12.0, 17.0, t)
	fx.tree_reveal = tree
	# Святые откликаются на каждый Ом — фигуры сияют ярче
	fx.tree_shine = maxf(_win(t, OM1.x + 2.0, OM1.y + 3.0, 3.0, 4.0), maxf(_win(t, OM2.x, OM2.y + 3.0, 2.0, 4.0), _win(t, OM3.x, OM3.y, 2.0, 3.0)))

	# Знак Ом в груди: появляется с первым Ом, ярче во время каждого Ом, растворяется на третьем
	var om_on := smoothstep(OM1.x - 0.5, OM1.x + 2.5, t) * (1.0 - smoothstep(OM3.x + 3.0, OM3.x + 8.0, t))
	var chant := maxf(_win(t, OM1.x, OM1.y + 1.0, 1.5, 3.0), maxf(_win(t, OM2.x, OM2.y + 1.0, 1.5, 3.0), _win(t, OM3.x, OM3.y, 1.5, 3.0)))
	fx.om_intensity = om_on * (0.55 + 0.45 * chant)
	fx.om_halo = om_on * (0.45 + 0.55 * chant)

	# Первый Ом — лучи расходятся во все стороны, к святым
	fx.rays_out = _win(t, OM1.x + 1.0, OM1.y + 1.5, 2.0, 3.0) * 1.2
	# Второй Ом — свет святых идёт обратно, к практикующему
	fx.rays_in = _win(t, OM2.x + 0.5, OM2.y + 1.5, 2.0, 3.0)

	# Сияние вокруг Датты: появляется вместе с древом и остаётся; на каждом Ом разгорается сильнее
	var boost := 0.4 * _win(t, OM1.x + 2.0, OM1.y + 4.0, 3.0, 5.0) + 0.6 * _win(t, OM2.x, OM2.y + 4.0, 2.0, 6.0)
	boost += 0.8 * smoothstep(OM3.x, OM3.x + 6.0, t) * (1.0 - smoothstep(BOW + 0.5, BOW + 6.0, t))
	fx.aura = 0.6 * tree + boost

	# Второй Ом: белый свет заполняет тело сверху вниз, потом едва заметно остаётся
	fx.veil_fill = smoothstep(OM2.x + 0.5, OM2.y, t) * 1.2
	fx.veil_alpha = 0.35 * _win(t, OM2.x, OM2.y + 3.0, 1.0, 4.0) + 0.08 * _win(t, OM2.y + 2.0, OM3.x + 2.0, 2.0, 2.0)

	# Третий Ом: растворение в чистом свете; после поклона сцена мягко возвращается
	fx.whiteout = smoothstep(OM3.x + 1.0, OM3.y - 1.0, t) * (1.0 - smoothstep(BOW + 1.0, BOW + 7.0, t))

	# Текст
	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
