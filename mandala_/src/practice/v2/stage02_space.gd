extends "res://src/practice/v2/v2_stage.gd"
## Этап 2 новой версии. Очищение пространства: Гаятри, Махамритьюнджая, Асатома, «Гурур Брахма».
## Поток света нисходит сверху и озаряет всё пространство золотистым светом. На экране — мантра и перевод.

const TITLE := "2. Очищение пространства"
const AUDIO := "res://audio/teurgia1_v2/02_four_mantras.mp3"
const DURATION := 107.0

# Где в записи звучит каждая мантра (по громкости); перед каждой ведущий коротко её называет
const GAYATRI_AT := Vector2(7.3, 28.1)
const MRITYUNJAYA_AT := Vector2(35.9, 56.2)
const ASATOMA_AT := Vector2(63.8, 79.5)
const GURUR_AT := Vector2(84.8, 104.2)

const CUES := [0.0, GAYATRI_AT.x - 1.0, MRITYUNJAYA_AT.x - 4.0, ASATOMA_AT.x - 4.0, GURUR_AT.x - 4.0]

const GAYATRI := "Ом бхур бхувах сваха,\nтат савитур вареньйам,\nбхарго дэвасьйа дхимахи,\nдхьйо йо нах прачодайат"
const MRITYUNJAYA := "Ом трйамбакам йаджамахе,\nсугандхим пушти вардханам,\nурварукамива бандханам,\nмритьор мукшийа ма'мритатэ"
const ASATOMA := "Ом асато ма сат гамайя,\nтамасо ма джьотир гамайя,\nмритьюр ма амритам гамайя"
const GURUR := "Гурур Брахма, гурур Вишну,\nгурур дэво Махешвара,\nгуру сакшат Парабрахма,\nтасмай шри гураве намаха"

const CAPTIONS := [
	[0.5, GAYATRI_AT.x - 0.5, "Мантра Гаятри", "Призывание просветляющей силы: пробуждение интуиции, буддхи."],
	[GAYATRI_AT.x - 0.5, GAYATRI_AT.y + 1.5, "Гаятри", GAYATRI + "\n\nМедитируем на сияющий свет божественного Савитара — пусть он пробудит наш разум."],
	[31.0, MRITYUNJAYA_AT.x - 0.5, "Махамритьюнджая-мантра", "Защита пространства."],
	[MRITYUNJAYA_AT.x - 0.5, MRITYUNJAYA_AT.y + 1.5, "Махамритьюнджая", MRITYUNJAYA + "\n\nПочитаем Трёхокого, благоуханного, питающего всех. Как спелый плод отделяется от стебля,\nпусть Он освободит нас от смерти — ради бессмертия."],
	[59.0, ASATOMA_AT.x - 0.5, "Гимн Асатома", "Молитва Абсолюту: призывание благословляющей силы Всевышнего Источника."],
	[ASATOMA_AT.x - 0.5, ASATOMA_AT.y + 1.0, "Асатома", ASATOMA + "\n\nВеди меня от неистинного к Истине, от тьмы к свету, от смерти к бессмертию."],
	[80.5, GURUR_AT.x - 0.5, "Мантра «Гурур Брахма»", "Призывание благословений Гуру, Ишта-дэваты и святых древа Прибежища."],
	[GURUR_AT.x - 0.5, DURATION, "Гурур Брахма", GURUR + "\n\nГуру — Брахма, Гуру — Вишну, Гуру — бог Махешвара.\nГуру — сам Высший Брахман: почтение этому Гуру."],
]

func apply(t: float, fx) -> void:
	# из света прошлого этапа проявляется пространство; сверху нисходит поток света и озаряет всё золотом
	fx.tree_reveal = 0.0
	var flow := smoothstep(2.0, 12.0, t) * (1.0 - smoothstep(DURATION - 6.0, DURATION, t))
	fx.light_column = 1.2 * flow
	fx.sky = 0.55 * flow
	_sky(t, fx, [[0.0, Backdrop.GOLDEN]])
	var sung := 0.0
	for s in [GAYATRI_AT, MRITYUNJAYA_AT, ASATOMA_AT, GURUR_AT]:
		sung = maxf(sung, _win(t, s.x, s.y, 2.0, 2.0))
	fx.light_column += 0.4 * sung * flow
	fx.sparkle = 0.5 * flow
	_captions(t, fx, CAPTIONS)
