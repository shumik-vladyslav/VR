extends "res://src/practice/v2/v2_stage.gd"
## Этап 7 новой версии. Начитывание семенной мантры «Ом Драм Даттатреяя намаха» 108 раз.
## Даттатрейя вырастает — слог Драм в центре его груди виден отчётливо, вокруг слога медленно вращается мантра.

const TITLE := "7. Начитывание мантры"
const AUDIO := "res://audio/teurgia1_v2/07_om_dram_108.mp3"
const DURATION := 586.0

const GROW := Vector2(1.0, 10.0)
const GROWN := 1.35
const CHANT_END := 554.0                 # дальше ведущий завершает начитывание
const SEAL := 572.0                      # «…запечатываем практику силой шамбхави-мудры»

const CUES := [0.0, 120.0, 240.0, 360.0, 480.0, CHANT_END]

const CAPTIONS := [
	[1.0, 30.0, "Начитывание семенной мантры", "Ом Драм Даттатреяя намаха — 108 раз.\nДаттатрейя увеличивается, в центре его груди отчётливо виден слог Драм; вокруг слога вращается мантра."],
	[30.5, CHANT_END - 0.5, "Ом Драм Даттатреяя намаха", "Ум спокойно следует за звуком мантры; взгляд — на слог Драм в груди Даттатрейи."],
	[CHANT_END, SEAL - 0.5, "", "Заканчивая начитывать мантру, поддерживаем преображение, визуализацию,\nвспоминаем четыре ключевые точки."],
	[SEAL, DURATION, "", "Медленно раскрываем глаза и запечатываем практику силой шамбхави-мудры."],
]

func apply(t: float, fx) -> void:
	fx.datta_reveal = 1.0
	fx.merge = 1.0
	fx.radiance = 0.3
	fx.body_glow = 0.4
	fx.aura = 1.1
	fx.datta_grow = lerpf(1.0, GROWN, smoothstep(GROW.x, GROW.y, t))
	fx.mantra_ring = _win(t, GROW.y - 3.0, CHANT_END + 6.0, 4.0, 6.0)
	fx.ring_turn = -0.08 * t
	fx.sky = 0.35
	_sky(t, fx, [[0.0, Backdrop.GOLDEN]])
	_captions(t, fx, CAPTIONS)
