func apply(t: float, fx) -> void:
	fx.datta_reveal = 1.0
	fx.merge = 1.0
	fx.radiance = 0.3
	fx.body_glow = 0.5
	fx.datta_grow = lerpf(1.0, GROWN, smoothstep(GROW.x, GROW.y, t))
	fx.aura = 1.2
	fx.sky = 0.4
	_sky(t, fx, [[0.0, Backdrop.GOLDEN]])
	fx.sparkle = 0.4 * (1.0 - smoothstep(140.0, DURATION, t))
	_captions(t, fx, CAPTIONS)
