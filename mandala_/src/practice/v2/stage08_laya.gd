extends "res://src/practice/v2/v2_stage.gd"
## Этап 8 новой версии. Медитация растворения (лайя-садхана).
## Сначала внешнее божество мудрости впитывается в сердечный центр: из груди Даттатрейи шар золотого света входит
## в грудь практикующего; медитация на четыре ключевые точки. Затем визуализация растворяется: Даттатрейя медленно
## растворяется в свете, остаётся только пространство голубого света. Записи нет — тихий гул поющей чаши.

const TITLE := "8. Медитация растворения"
const AUDIO := "res://audio/teurgia1_v2/bowl_drone.ogg"
const DURATION := 175.0

const ABSORB := Vector2(8.0, 26.0)       # шар золотого света из груди Даттатрейи в сердце
const POINTS := [26.0, 38.0, 50.0, 62.0, 74.0]   # бхава, спанда, джьоти, шакти
const DISSOLVE := Vector2(76.0, 96.0)    # Даттатрейя растворяется в свете
const SPACE := 96.0                      # только пространство голубого света
const SUBTLE := 135.0                    # медитация на тонкие виды пространства

const CUES := [0.0, ABSORB.x, POINTS[0], DISSOLVE.x, SPACE, SUBTLE]

const CAPTIONS := [
	[1.0, ABSORB.x - 0.5, "Воссоединение с божеством мудрости", "Даттатрейя перед вами, в его груди сияет слог Драм."],
	[ABSORB.x, ABSORB.y, "Впитывание божества мудрости", "Из груди Даттатрейи исходит шар золотого света и по лучу входит в ваш сердечный центр.\nБожество мудрости и семенной слог — в вашем сердце."],
	[POINTS[0], POINTS[1] - 0.5, "Четыре ключевые точки · Бхава", "Переживание: «Я — божество», живое чувство Его присутствия."],
	[POINTS[1], POINTS[2] - 0.5, "Четыре ключевые точки · Спанда", "Тонкая вибрация, пульсация сознания в теле божества."],
	[POINTS[2], POINTS[3] - 0.5, "Четыре ключевые точки · Джьоти", "Внутренний свет: тело божества сияет изнутри."],
	[POINTS[3], POINTS[4] - 0.5, "Четыре ключевые точки · Шакти", "Сила божества наполняет вас."],
	[DISSOLVE.x, DISSOLVE.y, "Растворение визуализации", "Даттатрейя медленно растворяется в свете."],
	[SPACE, SUBTLE - 0.5, "Шунья-ашунья", "Погружение в светоносное пространство — пустоту. Остаётся только пространство голубого света."],
	[SUBTLE, DURATION - 2.0, "Тонкие виды пространства", "Медитация на тонкие виды пространства."],
]

func apply(t: float, fx) -> void:
	fx.merge = 1.0
	fx.body_glow = 0.4 + 0.4 * smoothstep(ABSORB.y - 4.0, ABSORB.y + 2.0, t)
	fx.radiance = 0.3 + 0.3 * smoothstep(ABSORB.y - 4.0, ABSORB.y + 2.0, t)
	# шар света
	if t >= ABSORB.x and t <= ABSORB.y:
		fx.ball_phase = (t - ABSORB.x) / (ABSORB.y - ABSORB.x)
	# Даттатрейя растворяется в свете: свет нарастает, в самой яркой точке его уже нет, свет гаснет
	var gone := DISSOLVE.x + 9.0
	fx.datta_reveal = 1.0 if t < gone else 0.0
	fx.datta_light = _win(t, DISSOLVE.x, DISSOLVE.y, 9.0, 8.0)
	fx.aura = 1.0 * (1.0 - smoothstep(DISSOLVE.x, gone, t))
	fx.whiteout = 0.35 * pow(fx.datta_light, 2.0)
	# голубое пространство: вместе с растворением исчезают пол и всё вокруг
	fx.sky = smoothstep(DISSOLVE.x + 4.0, DISSOLVE.y, t)
	_sky(t, fx, [[0.0, Backdrop.SPACE]])
	fx.floor_visible = 0.0 if t > gone else 1.0
	fx.sparkle = 0.25 * smoothstep(SUBTLE, SUBTLE + 8.0, t)
	_captions(t, fx, CAPTIONS)
