extends RefCounted
## Этап 3. Очищение тела, речи, ума: садхана 21-го слога Ом.
## Древо уходит, в центре — большой Ом. На каждый Ом он испускает свет;
## на последнем (внутренний инструмент) всё растворяется в чистом свете, затем сцена возвращается.

const TITLE := "3. Садхана 21-го слога Ом"
const AUDIO := "res://audio/teurgia1/om21_purification.ogg"
const DURATION := 588.0   # запись 574 с + время вернуться из света

# Пропетые Ом (начало, конец) — по огибающей громкости и ровному тону ~115 Гц.
# В записи их 22: в первой группе шесть.
const OMS := [
	Vector2(96.5, 104.4), Vector2(111.8, 118.6), Vector2(124.7, 130.3), Vector2(136.7, 143.1), Vector2(149.2, 155.7), Vector2(162.8, 169.0),
	Vector2(199.6, 208.4), Vector2(217.7, 224.7), Vector2(232.3, 239.0), Vector2(246.3, 252.6), Vector2(258.3, 264.6),
	Vector2(293.1, 299.9), Vector2(306.3, 312.5), Vector2(318.5, 324.0), Vector2(331.1, 337.5), Vector2(346.6, 353.6),
	Vector2(382.9, 389.3), Vector2(411.2, 416.6), Vector2(435.6, 442.7), Vector2(460.3, 470.8), Vector2(508.8, 515.2),
	Vector2(559.4, 571.1),
]
const DISSOLVE := Vector2(559.4, 571.1)   # последний Ом — растворение в свете
const RETURN_AT := 576.0

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[0.5, 92.5, "Садхана 21-го слога Ом", "Очищение тонких тел, энергий, органов восприятия и действия. Вибрация Ом соединяет свет из межбровья с 21 таттвой — они очищаются и насыщаются светом."],
	[171.0, 186.0, "", "Санкальпа: пять органов действия полностью очищены."],
	[187.0, 195.5, "Пять органов восприятия", "Обоняние · вкус · зрение · слух · осязание"],
	[266.5, 280.0, "", "Санкальпа: пять органов чувств полностью очищены."],
	[280.5, 284.5, "Пять жизненных энергий", "Апана · самана · прана · удана · вьяна"],
	[355.5, 370.0, "", "Санкальпа: пять пран, жизненных энергий, очищены."],
	[370.5, 376.5, "Пять тел", "Физическое · энергетическое · астральное · ментальное · каузальное"],
	[577.0, 588.0, "", "Поклон. Двадцать одна таттва очищена."],
]

const ACTION := "Пять органов действия"
const SENSES := "Пять органов восприятия"
const ENERGIES := "Пять жизненных энергий"
const SHEATHS := "Пять тел"
const INNER := "Внутренний инструмент"
# Двадцать одна таттва — с момента, когда ведущий её называет: [начало, конец, номер, группа, название].
# Номер — и часть тела на схеме. Первая таттва звучит дважды: в записи 22 Ом
const TATTVAS := [
	[93.0, 120.5, 1, ACTION, "Язык"],
	[121.0, 132.5, 2, ACTION, "Руки"],
	[133.0, 144.5, 3, ACTION, "Ноги"],
	[145.0, 156.5, 4, ACTION, "Гениталии"],
	[157.0, 170.5, 5, ACTION, "Выделительная система"],
	[196.0, 211.5, 6, SENSES, "Нос, обоняние"],
	[212.0, 225.5, 7, SENSES, "Язык, вкусовое сознание"],
	[226.0, 239.5, 8, SENSES, "Глаза, зрительное сознание"],
	[240.0, 253.5, 9, SENSES, "Уши, слуховое сознание"],
	[254.0, 266.0, 10, SENSES, "Кожа, осязание"],
	[285.0, 300.5, 11, ENERGIES, "Апана — ниже пупка, колени и стопы"],
	[301.0, 312.5, 12, ENERGIES, "Самана — живот"],
	[313.0, 325.5, 13, ENERGIES, "Прана — грудная клетка"],
	[326.0, 339.5, 14, ENERGIES, "Удана — шея и голова"],
	[340.0, 355.0, 15, ENERGIES, "Вьяна — кожа по всему телу"],
	[377.0, 403.5, 16, SHEATHS, "Аннамайя — физическая оболочка"],
	[404.0, 426.5, 17, SHEATHS, "Пранамайя — энергетическая оболочка"],
	[427.0, 453.5, 18, SHEATHS, "Маномайя — астральная оболочка"],
	[454.0, 486.5, 19, SHEATHS, "Виджнянамайя — ментальная оболочка"],
	[487.0, 518.5, 20, SHEATHS, "Анандамайя — причинное тело, оболочка блаженства"],
	[519.0, 534.0, 21, INNER, "Настраиваемся на Абсолют, на Всевышний источник"],
	[534.5, 560.0, 21, INNER, "Читта, манас, буддхи и ахамкара воссоединяются с чистым светом высшего «Я»"],
]
# Когда на экране схема тела: группы таттв целиком, между таттвами она не гаснет
const CHART := [Vector2(93.0, 170.5), Vector2(196.0, 266.0), Vector2(285.0, 355.0), Vector2(377.0, 560.0)]

var CUES: Array = []

func _init() -> void:
	CUES.append(0.0)
	for o in OMS:
		CUES.append(o.x - 1.0)

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Древо уходит, вместо него проявляется большой Ом
	fx.tree_reveal = 1.0 - smoothstep(0.5, 4.0, t)
	var om_on := smoothstep(2.0, 7.0, t)

	# Цикл каждого Ом: пока Ом не звучит — едва заметное свечение; во время Ом — сильные лучи из центра знака,
	# волна света бежит к практикующему и доходит к концу пропевания; в конце Ом — растворение в свете,
	# затем свет отступает и сцена ждёт следующего Ом
	var chant := 0.0
	var pulse := -1.0
	var dissolve := 0.0
	for i in OMS.size():
		var o: Vector2 = OMS[i]
		chant = maxf(chant, _win(t, o.x - 0.3, o.y + 0.6, 1.0, 1.2))
		if t >= o.x and t <= o.y + 1.0:
			pulse = (t - o.x) / (o.y - o.x)
		if i < OMS.size() - 1:
			dissolve = maxf(dissolve, smoothstep(o.y - 1.5, o.y + 0.3, t) * (1.0 - smoothstep(o.y + 1.5, o.y + 4.5, t)))
	fx.center_om = om_on * (0.45 + 0.4 * chant)
	fx.center_halo = om_on * (0.12 + 0.6 * chant)
	fx.center_rays = 0.6 * chant
	fx.center_beams = om_on * (0.02 + 0.6 * chant)
	fx.center_pulse = pulse
	fx.aura = 0.0

	# Растворение в свете в конце каждого Ом; последний Ом — полное растворение, после паузы сцена возвращается
	var final_white := smoothstep(DISSOLVE.x + 1.0, DISSOLVE.y - 1.0, t) * (1.0 - smoothstep(RETURN_AT, RETURN_AT + 7.0, t))
	fx.whiteout = maxf(final_white, 0.85 * dissolve)

	# Схема тела: светится то, что называет ведущий; на каждый Ом — ярче
	fx.chart_alpha = 0.0
	for c in CHART:
		fx.chart_alpha = maxf(fx.chart_alpha, _win(t, c.x, c.y, 1.0, 1.0))
	fx.chart_pulse = chant

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for v in TATTVAS:
		if t >= v[0]:
			fx.chart_part = v[2]
		if t >= v[0] and t <= v[1]:
			fx.title = "%d из 21  ·  %s" % [v[2], v[4]]
			fx.text = v[3]
			fx.text_alpha = _win(t, v[0], v[1], 0.5, 0.5)
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
