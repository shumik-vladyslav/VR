extends RefCounted
## Этап 4. Прибежище: снова древо Прибежища; во время пения мантры Прибежища святые мягко сияют.

const TITLE := "4. Прибежище"
const AUDIO := "res://audio/teurgia1/refuge.ogg"
const DURATION := 237.0

# Где в записи поётся мантра «Намо Гурудэва…» — по огибающей громкости
const SUNG := Vector2(159.0, 196.0)

const CUES := [0.0, 18.0, 97.0, 159.0, 195.5]

# Ведущий проходит древо сверху вниз (по записи): [начало, конец, ряды древа]
const NAMED := [
	[18.0, 27.0, [0]],          # золотая сфера, Тримурти
	[27.0, 33.0, [1]],          # Брахма, Вишну, Ишвара
	[33.0, 54.5, [2]],          # четыре кумара
	[55.0, 65.5, [3]],          # семь риши
	[65.5, 72.0, [5, 6]],       # Бхагаван Даттатрейя
	[72.0, 80.5, [7, 8, 9]],    # линия передачи: Шанкарачарья, Брахмананда
	[81.0, 92.0, [10]],         # коренной Гуру
]
# Подношение цветов по записи: пригоршня в правой руке, круги с мантрой, бросок к древу
const RED_SHOW := 97.0
const RED_TOSS := 195.5
const RED_TOSS_TIME := 3.5

const REFUGE_MANTRA := "НАМО  ГУРУДЭВА\nНАМО  САТЬЯ  ДХАРМА\nНАМО  АРЬЯ  САНГХА"

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[1.0, 17.5, "Древо Прибежища", "Представьте прямо перед собой древо Прибежища — так, как оно изображено на рисунке."],
	[18.0, 26.8, "Хираньягарбха", "Золотая сфера — Золотой зародыш: принцип Брахмы-творца и Ишвары, Абсолюта."],
	[27.0, 32.8, "Брахма · Вишну · Ишвара", "Три главных бога."],
	[33.0, 54.5, "Четыре кумара", "Санат-кумара, Санатана, Санака, Сананда — сыновья Брахмы, рождённые умом.\nОни тонко регулируют и благословляют всё мироздание и всех живых существ."],
	[55.0, 65.3, "Семь риши", "Васиштха · Вишвамитра · Кашьяпа · Бхарадваджа · Джамадагни · Гаутама · Атри — отец Даттатрейи"],
	[65.5, 71.8, "Бхагаван Даттатрейя", "Центральная фигура древа Прибежища."],
	[72.0, 80.5, "Линия передачи", "Шри Ади Шанкарачарья. Ещё ниже — Парам Гуру Брахмананда."],
	[81.0, 92.0, "Коренной Гуру", "Форма коренного Гуру — в чистом видении."],
	[97.0, 116.0, "Подношение цветов", "В правой руке — пригоршня красных цветов. С мантрой Прибежища мысленно обносим их трижды по часовой стрелке, а затем подбрасываем в воздух."],
	[117.0, 157.5, "Мудрость и сострадание", "Все божества древа делают благословляющие мудры: Абхая — «ничего не бойся», Варада — «все твои желания исполнятся».\nОни поют благословляющие песни для нашей удачи на духовном пути, а мы делаем им подношение с мантрой."],
	[159.0, 195.0, "Мантра Прибежища", REFUGE_MANTRA],
	[196.0, 236.0, "", "Я выражаю почтение Гуру — коренному Гуру, Гуру-ачарье, Парам Гуру, Сатгуру.\nДхарме, которую они несут. Святой Сангхе — собранию святых и божественных мудрецов.\nПримите эти цветы как моё подношение, мою веру и преданность."],
]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Древо снова проявляется (после большого Ома этапа 3) и остаётся
	var tree := smoothstep(0.0, 4.0, t)
	fx.tree_reveal = tree

	# Лёгкое сияние, пока поётся мантра Прибежища; святые разгораются, когда до них долетают цветы
	var sing := _win(t, SUNG.x, SUNG.y + 1.5, 3.0, 4.0)
	var received := _win(t, RED_TOSS + 2.5, RED_TOSS + 12.0, 1.0, 5.0)
	fx.tree_shine = maxf(0.5 * sing, 0.9 * received)
	fx.aura = tree * (0.6 + 0.3 * sing + 0.3 * received)

	# Ряд древа, о котором сейчас говорит ведущий, подсвечивается
	var focus := {}
	for n in NAMED:
		var f := _win(t, n[0], n[1], 0.8, 1.0)
		for row in n[2]:
			focus[row] = maxf(focus.get(row, 0.0), f)
	fx.tree_focus = focus

	# Пригоршня красных цветов в правой руке; с мантрой — три круга по часовой стрелке; затем бросок к древу
	fx.red_flowers = smoothstep(RED_SHOW, RED_SHOW + 1.5, t) if t < RED_TOSS + RED_TOSS_TIME else 0.0
	fx.red_circle = 3.0 * clampf((t - SUNG.x) / (RED_TOSS - 1.0 - SUNG.x), 0.0, 1.0)
	fx.red_toss = clampf((t - RED_TOSS) / RED_TOSS_TIME, 0.0, 1.0)

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
