const CUES := [0.0, 58.0, 106.0, 157.0, 203.0, 243.0, 289.0, 342.0, 373.0, 411.0]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Даттатрейя вовне — на лотосе в сиянии; практикующий остаётся в теле божества медитации
	fx.datta_reveal = 1.0
	fx.merge = 1.0
	fx.radiance = 0.3
	fx.body_glow = 0.5
	# сияние дышит вместе с бхаджаном: ярче, пока поётся куплет
	var sung := 0.0
	for v in VERSES:
		sung = maxf(sung, _win(t, v[0], v[1], 3.0, 3.0))
	fx.aura = 0.8 + 0.3 * sung

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	if t < 16.0:
		fx.title = "Датта Става — призывание божества мудрости"
		fx.text = "Представьте Даттатрейю перед собой. Пока звучит бхаджан, совершайте манасика-пуджу:\nподносите лепестки, цветы, плоды, огонь, благовония и воду."
		fx.text_alpha = _win(t, 1.0, 16.0, 1.5, 1.5)
		return
	for v in VERSES:
		if t >= v[0] and t <= v[1]:
			fx.title = v[2]
			fx.text = v[3]
			fx.text_alpha = _win(t, v[0], v[1], 1.5, 1.5)
			break
