extends RefCounted
## Этап 8. Запечатывание — завершающее подношение. Практикующий в теле божества медитации, Даттатрейя на лотосе.
## Естественное состояние (шамбхави-мудра) — пространство светлеет и затихает; гордость божества — в зеркале
## из света снова виден себя божеством; чистое видение — всё пространство мандалы в искрах света;
## Четыре Безмерных состояния Брахмы — из слога Ом в центре груди волнами расходится свет ко всем существам,
## у каждого состояния свой цвет.
## Записи пока нет: время условное, ведут подписи. Когда появится запись — задать AUDIO и сверить моменты.

const TITLE := "8. Запечатывание"
const AUDIO := ""
const DURATION := 272.0

const SHAMBHAVI := Vector2(12.0, 62.0)       # естественное состояние
const PRIDE := Vector2(62.0, 105.0)          # гордость божества
const VISION := Vector2(105.0, 150.0)        # чистое видение
const BRAHMA := 150.0                        # Четыре Безмерных — вступление
const STATES := [158.0, 184.0, 210.0, 236.0] # любовь, сострадание, сорадование, равностность
const SEAL := 262.0                          # свет возвращается в слог, запечатывание
const RING_PERIOD := 4.5

# Цвета света Четырёх Безмерных
const STATE_COLORS := [Color(1.0, 0.58, 0.62), Color(0.45, 0.72, 1.0), Color(1.0, 0.82, 0.3), Color(0.95, 0.97, 1.0)]

const CUES := [0.0, SHAMBHAVI.x, PRIDE.x, VISION.x, BRAHMA, 158.0, 184.0, 210.0, 236.0, SEAL]

# [начало, конец, заголовок, текст]
const CAPTIONS := [
	[1.0, 11.5, "Запечатывание", "Завершающее подношение: всё, что пробудилось в практике, мы запечатываем в себе."],
	[12.5, 34.0, "Естественное состояние — шамбхави-мудра", "Глаза открыты, взгляд мягко направлен вперёд и чуть вверх, в пространство, ни на чём не фокусируясь.\nУм отпускает мысли и покоится сам в себе, без усилия."],
	[62.5, 84.0, "Гордость божества", "Ясно осознайте: «Я — Даттатрейя». Тело, речь и ум — тело, речь и ум божества.\nЭто не гордыня эго, а твёрдая уверенность в своей чистой природе."],
	[105.5, 128.0, "Чистое видение", "Всё вокруг — чистая мандала, все существа — божества, все звуки — мантра,\nвсе мысли — игра мудрости."],
	[150.5, 157.5, "Четыре Безмерных состояния Брахмы", "Из слога Ом в центре груди свет расходится во все стороны, ко всем живым существам."],
	[158.0, 183.5, "Безмерная любовь — майтри", "Пусть все существа будут счастливы и обретут причины счастья."],
	[184.0, 209.5, "Безмерное сострадание — каруна", "Пусть все существа будут свободны от страдания и его причин."],
	[210.0, 235.5, "Безмерная радость — мудита", "Пусть все существа никогда не разлучаются с истинным счастьем, свободным от страдания.\nРадуемся счастью и благу каждого."],
	[236.0, 261.5, "Безмерная равностность — упекша", "Пусть все существа пребывают в равностности, свободные от привязанности к близким\nи неприязни к далёким."],
	[262.5, 271.0, "", "Свет возвращается в слог в центре груди. Практика запечатана."],
]

func _win(t: float, a: float, b: float, fade_in: float, fade_out: float) -> float:
	return smoothstep(a, a + fade_in, t) * (1.0 - smoothstep(b - fade_out, b, t))

func apply(t: float, fx) -> void:
	# Даттатрейя на лотосе в сиянии; практикующий — в теле божества медитации
	fx.datta_reveal = 1.0
	fx.merge = 1.0

	# Естественное состояние: пространство мягко светлеет и затихает, сияние ровное
	var natural := _win(t, SHAMBHAVI.x, SHAMBHAVI.y, 6.0, 6.0)
	fx.whiteout = 0.16 * natural
	# Гордость божества: тело сияет в полную силу, в зеркале из света — себя божеством
	var pride := _win(t, PRIDE.x, PRIDE.y, 4.0, 5.0)
	fx.mirror = pride
	# Чистое видение: всё пространство в искрах света — и до конца этапа
	var vision := smoothstep(VISION.x, VISION.x + 6.0, t)
	fx.sparkle = vision * (1.0 - 0.4 * smoothstep(BRAHMA, BRAHMA + 6.0, t))

	# Четыре Безмерных: знак Ом в центре груди, лучи и волны света его цвета
	var brahma := _win(t, BRAHMA, SEAL + 4.0, 3.0, 6.0)
	var i := -1
	for k in STATES.size():
		if t >= STATES[k]:
			i = k
	var color: Color = STATE_COLORS[maxi(i, 0)]
	var radiate := 0.0
	if i >= 0 and t < SEAL:
		var end: float = STATES[i + 1] if i + 1 < STATES.size() else SEAL
		radiate = _win(t, STATES[i], end, 2.5, 2.5)
		fx.ring_phase = fmod(t - STATES[i], RING_PERIOD) / RING_PERIOD
		fx.ring_strength = 1.3 * radiate
		fx.ring_color = color
	fx.om_intensity = brahma * (0.6 + 0.3 * radiate)
	fx.om_halo = brahma * (0.4 + 0.5 * radiate)
	fx.rays_out = 1.3 * radiate
	fx.rays_tint = Color(color.r, color.g, color.b, 0.85)
	# Запечатывание: свет возвращается из пространства в слог
	fx.rays_in = _win(t, SEAL, DURATION, 2.0, 4.0)

	fx.radiance = 0.3 + 0.4 * pride + 0.2 * radiate
	fx.body_glow = 0.5 + 0.5 * pride + 0.3 * radiate
	fx.body_light = 0.5 * pride
	fx.eyes_glow = 0.4 * pride
	fx.aura = 0.8 + 0.3 * pride + 0.4 * vision

	fx.title = ""
	fx.text = ""
	fx.text_alpha = 0.0
	for c in CAPTIONS:
		if t >= c[0] and t <= c[1]:
			fx.title = c[2]
			fx.text = c[3]
			fx.text_alpha = _win(t, c[0], c[1], 1.0, 1.0)
			break
